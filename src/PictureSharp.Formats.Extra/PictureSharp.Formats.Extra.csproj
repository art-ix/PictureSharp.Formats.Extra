<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Extra</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Formats.Extra</PackageId>
    <Description>QOI, PNM, TGA, DDS, PSD, SGI, Sun Raster, XBM, XPM, VTF and ICNS image formats for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;qoi;pnm;ppm;pgm;pam;tga;targa;dds;directdraw;bc7;bc6h;psd;psb;photoshop;sgi;sunraster;xbm;xpm;vtf;valve;icns;apple;codec;decoder;encoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Formats.Extra</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
